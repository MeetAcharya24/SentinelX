# Backend
APP_ENV=development
DATABASE_URL=sqlite:///./sentinelx.db
LOG_LEVEL=info
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Largest request body the API accepts, in bytes (default 1048576)
# MAX_REQUEST_BYTES=
# Folder holding downloaded datasets (defaults to ./data at the repository root)
# DATA_DIR=
# Folder holding the trained network detector (defaults to backend/artifacts/network)
# MODEL_DIR=
# PHISHING_MODEL_DIR=
# Folder with optional known-bad lists bad_ips.txt and bad_domains.txt
# (defaults to <DATA_DIR>/blocklists)
# BLOCKLIST_DIR=

# AI security analyst (optional — leave blank to use the deterministic no-key fallback)
LLM_PROVIDER=groq
GROQ_API_KEY=
# Hosted analyst model (default openai/gpt-oss-120b) and the local ceiling on hosted calls
# GROQ_MODEL=
# ANALYST_CALLS_PER_MINUTE=3
# ANALYST_CALLS_PER_DAY=50

# Per-client request rate limit (token bucket; 0 per minute turns it off). Set
# TRUST_PROXY_HEADERS=true only behind a reverse proxy that sets X-Forwarded-For.
# RATE_LIMIT_PER_MINUTE=120
# RATE_LIMIT_BURST=40
# TRUST_PROXY_HEADERS=false

# Write protection (optional). Leave unset locally: nothing is checked. On a deployed instance set a
# long random value (at least 16 characters, e.g. `openssl rand -hex 24`); the analyze endpoints,
# PATCH /alerts/{id} and the analyst refresh then need an `X-Demo-Write-Token` header with the same
# value. Reads and /health stay open. Never commit the real value.
# DEMO_WRITE_TOKEN=

# Threat intelligence (optional). Free Auth-Key from https://auth.abuse.ch/ for the ThreatFox feed;
# leave blank to refresh Feodo Tracker only (needs no key). Never commit a real key.
THREATFOX_API_KEY=
# Run one threat-intel refresh in the background when the server starts (hosts with no scheduler).
# STARTUP_INTEL_REFRESH=false

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
