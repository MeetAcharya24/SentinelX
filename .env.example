# Backend
APP_ENV=development
DATABASE_URL=sqlite:///./sentinelx.db
LOG_LEVEL=info
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Largest request body the API accepts, in bytes (default 1048576)
# MAX_REQUEST_BYTES=
# Folder holding downloaded datasets (defaults to ./data at the repository root)
# DATA_DIR=
# Folder holding the trained network detector (defaults to backend/artifacts/network)
# MODEL_DIR=
# PHISHING_MODEL_DIR=

# AI security analyst (optional — leave blank to use the deterministic no-key fallback)
LLM_PROVIDER=groq
GROQ_API_KEY=

# Threat intelligence enrichment (optional — leave blank to disable)
THREAT_INTEL_API_KEY=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
